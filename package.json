{
  "name": "giroksam",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "test": "vinext build && node --test tests/rendered-html.test.mjs tests/operation-safety.test.mjs && node --experimental-strip-types --test tests/record-validation.test.ts tests/comment-generation-policy.test.ts",
    "test:smoke": "node --test tests/production-api-smoke.mjs tests/production-security-smoke.mjs",
    "test:security": "node --test tests/production-security-smoke.mjs",
    "test:public-smoke": "node --test tests/public-production-smoke.mjs",
    "test:supply-chain": "node scripts/check-lockfile-safety.mjs",
    "test:actions": "node scripts/check-workflow-action-pins.mjs",
    "test:secrets": "node scripts/check-tracked-secrets.mjs",
    "test:e2e": "playwright test",
    "test:load-comments": "node scripts/load-test-comments.mjs",
    "test:load-comments:preflight": "node scripts/load-test-comments.mjs preflight",
    "test:load-behaviors": "node scripts/load-test-behaviors.mjs",
    "test:load-behaviors:preflight": "node scripts/load-test-behaviors.mjs preflight",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "db:migrate-auth": "node scripts/migrate-auth-ownership.mjs",
    "db:migrate-confirmation": "node scripts/migrate-confirmation-status.mjs",
    "db:migrate-ai-usage": "node scripts/migrate-ai-usage.mjs",
    "db:migrate-ai-token-usage": "node scripts/migrate-ai-token-usage.mjs",
    "db:migrate-comment-parts": "node scripts/migrate-generated-comment-parts.mjs",
    "db:migrate-revisions": "node scripts/migrate-record-revisions.mjs",
    "db:migrate-generation-jobs": "node scripts/migrate-generation-jobs.mjs",
    "db:configure-generation-cron": "node scripts/configure-generation-job-cron.mjs",
    "db:migrate-behavior-jobs": "node scripts/migrate-behavior-generation-jobs.mjs",
    "db:migrate-student-reordering": "node scripts/migrate-student-reordering.mjs",
    "db:migrate-plan-versions": "node scripts/migrate-assessment-plan-versions.mjs",
    "db:migrate-level-statuses": "node scripts/migrate-assessment-level-statuses.mjs",
    "db:migrate-comment-evidence": "node scripts/migrate-comment-evidence-validation.mjs",
    "db:migrate-pilot-feedback": "node scripts/migrate-pilot-feedback.mjs",
    "db:migrate-behavior-evidence": "node scripts/migrate-behavior-evidence-validation.mjs",
    "db:migrate-comment-candidates": "node scripts/migrate-comment-candidates.mjs",
    "db:migrate-school-organizations": "node scripts/migrate-school-organizations.mjs",
    "db:migrate-shared-plans": "node scripts/migrate-shared-assessment-plans.mjs",
    "db:migrate-classroom-collaborators": "node scripts/migrate-classroom-collaborators.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.8",
    "@vercel/functions": "^3.7.5",
    "drizzle-orm": "0.45.2",
    "next": "16.2.12",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.12",
    "postgres": "^3.4.9",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.1.5",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
